RAG_APP_NAME="Placement Intelligence RAG"
RAG_ENVIRONMENT=local
RAG_DEBUG=false
RAG_API_V1_PREFIX=/api/v1
RAG_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

RAG_LOG_LEVEL=INFO
RAG_LOG_JSON=false

RAG_EMBEDDING_PROVIDER=sentence_transformers
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_DIMENSIONS=384
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_CACHE_PATH=data/vectorstores/all_minilm_l6_v2_cache.json

RAG_VECTOR_STORE=faiss
RAG_VECTOR_COLLECTION=placement_intelligence
RAG_FAISS_INDEX_PATH=data/vectorstores/placement_intelligence.faiss
RAG_FAISS_METADATA_PATH=data/vectorstores/placement_intelligence.metadata.json
RAG_QDRANT_URL=
RAG_QDRANT_API_KEY=
RAG_PINECONE_API_KEY=
RAG_WEAVIATE_URL=
RAG_WEAVIATE_API_KEY=

RAG_LLM_PROVIDER=openai
RAG_LLM_MODEL=gpt-4o-mini
RAG_OPENAI_API_KEY=
RAG_LLM_TEMPERATURE=0
RAG_LLM_MAX_OUTPUT_TOKENS=500

# Non-prefixed aliases are also supported for deployment platforms.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

RAG_MAX_RETRIEVAL_RESULTS=5
